[Unit]
Description=D&D Companion PWA at https://dndcompanion.pl/app/
After=network-online.target dnd-dns.service dnd-api.service
Wants=network-online.target

[Service]
Type=simple
User=rabu
Group=rabu
WorkingDirectory=/home/rabu/aplikacja_dnd
Environment=PWA_BASE=/app/
Environment=PWA_OUT_DIR=dist-pwa
Environment=PWA_HTTPS_KEY=/home/rabu/.local/share/dnd-pwa-tls/server.key
Environment=PWA_HTTPS_CERT=/home/rabu/.local/share/dnd-pwa-tls/server.crt
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/bin/npm run preview --workspace mobile -- --host 192.168.1.5 --port 443 --strictPort
Restart=on-failure
RestartSec=3

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rabu/aplikacja_dnd/mobile
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
