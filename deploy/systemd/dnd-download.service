[Unit]
Description=D&D Companion download page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rabu/aplikacja_dnd/mobile/download
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 0.0.0.0
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
