NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://dnd_app:change-me@127.0.0.1:5432/dnd_app
DATABASE_SSL=false
CORS_ORIGINS=https://rabuuwu.github.io,capacitor://localhost,https://localhost,http://localhost,http://localhost:5173
JWT_SECRET=generate-at-least-64-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
